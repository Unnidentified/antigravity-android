<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Antigravity" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/antigravity_primary</item>
        <item name="colorOnPrimary">@color/antigravity_on_primary</item>
        <item name="colorPrimaryContainer">@color/antigravity_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/antigravity_on_primary_container</item>
        <item name="colorSurface">@color/antigravity_surface</item>
        <item name="colorOnSurface">@color/antigravity_text_primary</item>
        <item name="colorSurfaceVariant">@color/antigravity_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/antigravity_text_secondary</item>
        <item name="colorOutline">@color/antigravity_outline</item>
        <item name="android:colorBackground">@color/antigravity_background</item>
        <item name="android:windowBackground">@color/antigravity_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Antigravity.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/antigravity_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Antigravity</item>
    </style>

</resources>
